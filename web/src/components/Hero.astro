---
import Icon from './Icon.astro';
import Paws from './Paws.astro';
import StoreButtons from './StoreButtons.astro';
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang; variant?: 'a' | 'b' }
const { lang, variant = 'a' } = Astro.props;
const c = t(lang);
---
{variant === 'a' ? (
<section id="top" class="hero"><Paws layout="scatter" size={56} opacity={.1} />
  <div class="wrap grid-2 inner">
    <div class="copy">
      <span class="pill"><Icon name="check" size={16} stroke={2.6} />{c.hero.badge}</span>
      <h1>{c.hero.h1}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="ctas"><a href="/rejestracja" class="btn btn-p big">{c.hero.cta}</a><StoreButtons lang={lang} /></div>
      <div class="proof muted"><span><span class="stars" aria-hidden="true">★★★★★</span> <b>{c.hero.rating}</b></span><span>·</span><span>{c.hero.rodo}</span><span>·</span><span>{c.hero.offline}</span></div>
    </div>
    <div class="art">
      <picture><source media="(max-width: 700px)" srcset="/brand/header-mobile.webp"><img src="/brand/header2-1600.webp" srcset="/brand/header2-800.webp 800w, /brand/header2-1600.webp 1600w" sizes="(max-width: 900px) 100vw, 560px" alt={c.hero.imgAlt} width="1600" height="900" fetchpriority="high"></picture>
      <div class="phone ph"><img src="/img/app/m-start.webp" alt={c.hero.phoneAlt} width="390" height="844" loading="eager"></div>
      <div class="toast"><span class="ico"><Icon name="heart" size={18} stroke={2.2} /></span><div><b>{c.hero.toast[0]}</b><div class="muted small">{c.hero.toast[1]}</div></div></div>
    </div>
  </div>
  <svg class="wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 C 240 100, 420 10, 720 40 S 1200 90, 1440 30 L1440 90 L0 90 Z" fill="var(--surface)"></path></svg>
</section>
) : (
<section id="top" class="hero b">
  <div class="wrap center">
    <span class="pill dark"><span class="dot"></span>{c.hero.newsBadge}</span>
    <h1 class="huge">{c.hero.h1b[0]}<br>{c.hero.h1b[1]}<span class="accent">{c.hero.h1b[2]}</span>{c.hero.h1b[3]}</h1>
    <p class="lead">{c.hero.leadB}</p>
    <div class="ctas mid"><a href="/rejestracja" class="btn btn-p big">{c.hero.cta}</a><StoreButtons lang={lang} /></div>
    <div class="proof muted"><span><span class="stars" aria-hidden="true">★★★★★</span> <b>{c.hero.rating}</b></span><span>·</span><span>{c.hero.badge.split('·')[0]}</span><span>·</span><span>{c.hero.rodo}</span></div>
  </div>
  <div class="wrap">
    <div class="window">
      <div class="dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <img src="/img/app/d-start-dark.webp" alt={c.video.alt} width="1440" height="900" fetchpriority="high">
      <div class="phone ph2"><img src="/img/app/m-start-dark.webp" alt={c.hero.phoneAlt} width="390" height="844" loading="eager"></div>
    </div>
  </div>
</section>
)}
<style>
  .hero { position: relative; overflow: hidden; padding: 64px 0 0; }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 800px 500px at 85% 0%, var(--soft) 0%, transparent 70%); pointer-events: none; }
  .inner { position: relative; gap: 40px; }
  .copy { display: flex; flex-direction: column; gap: 22px; max-width: 560px; }
  .pill { display: inline-flex; align-items: center; gap: 8px; background: var(--soft); color: var(--primary-text); padding: 8px 14px; border-radius: 999px; width: fit-content; font-size: 13px; font-weight: 800; }
  .pill.dark { background: var(--surface); border: 1px solid var(--border); color: var(--muted); } .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--primary); }
  h1 { font-size: 56px; letter-spacing: -.5px; } .huge { font-size: 76px; letter-spacing: -1.5px; max-width: 980px; } .accent { color: var(--primary); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; } .ctas.mid { justify-content: center; } .big { min-height: 56px; padding: 0 28px; }
  .proof { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; font-size: 14px; } .proof b { color: var(--text); } .stars { color: var(--warn); letter-spacing: 1px; }
  .art { position: relative; min-height: 560px; }
  .art picture img { width: 100%; height: 440px; object-fit: cover; border-radius: 32px; box-shadow: var(--shadow); }
  .ph { position: absolute; left: 24px; bottom: -40px; width: 230px; }
  .toast { position: absolute; right: 18px; bottom: 36px; background: var(--surface); border-radius: 18px; padding: 12px 16px; box-shadow: 0 14px 30px rgba(27,42,34,.14); display: flex; align-items: center; gap: 12px; font-size: 14px; }
  .ico { width: 36px; height: 36px; border-radius: 12px; background: var(--soft); color: var(--primary-text); display: flex; align-items: center; justify-content: center; }
  .small { font-size: 12px; }
  .wave { margin-top: 56px; }
  .b { padding: 88px 0 0; } .b::before { background: radial-gradient(ellipse 900px 520px at 50% -10%, rgba(79,212,99,.28) 0%, transparent 70%); }
  .center { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; } .center .lead { max-width: 680px; font-size: 20px; }
  .window { position: relative; margin-top: 56px; border-radius: 28px 28px 0 0; border: 1px solid var(--border); border-bottom: 0; background: var(--surface); padding: 12px 12px 0; box-shadow: 0 -20px 80px rgba(79,212,99,.12); }
  .dots { display: flex; gap: 6px; padding: 0 6px 12px; } .dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--border); }
  .window > img { width: 100%; height: 520px; object-fit: cover; object-position: top; border-radius: 16px 16px 0 0; }
  .ph2 { position: absolute; right: 56px; bottom: 0; width: 220px; }
  @media (max-width: 900px) {
    .hero { padding-top: 32px; } h1 { font-size: 38px; } .huge { font-size: 44px; letter-spacing: -1px; }
    .art { min-height: 0; margin-bottom: 70px; } .art picture img { height: 240px; border-radius: 24px; } .ph { width: 118px; bottom: -60px; left: auto; right: 14px; } .toast { display: none; }
    .window > img { height: 300px; } .ph2 { display: none; } .center .lead { font-size: 17px; } .wave { margin-top: 24px; height: 50px; }
  }
</style>
