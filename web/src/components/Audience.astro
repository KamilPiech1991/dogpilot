---
// Dla kogo: dwa tryby aplikacji (hodowca / właściciel psa) + ścieżka dla nabywcy szczenięcia z kodem QR.
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang; variant?: 'a' | 'b' }
const { lang, variant = 'a' } = Astro.props;
const c = t(lang); const a = c.audience;
const signup = lang === 'pl' ? '/rejestracja' : '/en/logowanie';
---
<section id="dla-kogo" class={`aud ${variant}`}><div class="wrap col">
  <div class="head reveal"><span class="kicker">{a.kicker}</span><h2>{a.h2}</h2><p class="lead">{a.p}</p></div>
  <div class="grid-2 modes">
    {[a.breeder, a.owner].map((m, i) => <article class={`card mode ${i ? 'owner' : 'breeder'} reveal`}>
      <div class="copy">
        <span class="pill"><Icon name={i ? 'heart' : 'paw'} size={16} stroke={2.6} />{m.name}</span>
        <h3>{m.h3}</h3><p class="muted">{m.p}</p>
        <ul>{m.items.map(b => <li class="check"><Icon name="check" size={20} stroke={2.6} />{b}</li>)}</ul>
        <a href={signup} class="btn btn-p btn-sm">{m.cta}</a>
      </div>
      <div class="phone shot"><img src={`/img/app/${m.img}.webp`} alt={m.alt} width="390" height="844" loading="lazy"></div>
    </article>)}
  </div>
  <div class="card buyer reveal"><span class="qr"><Icon name="qr" size={28} /></span><div><h3>{a.buyer.h3}</h3><p class="muted">{a.buyer.p}</p></div><a href="#przekazanie" class="btn btn-o btn-sm">{a.buyer.cta}</a></div>
</div></section>
<style>
  .aud { padding: 88px 0 24px; } .aud.b { padding: 72px 0 0; }
  .col { display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 12px; max-width: 760px; } h2 { font-size: 44px; letter-spacing: -.6px; }
  .modes { align-items: stretch; gap: 24px; }
  .mode { display: grid; grid-template-columns: 1fr 150px; gap: 20px; align-items: end; padding: 32px; overflow: hidden; }
  .copy { display: flex; flex-direction: column; gap: 14px; align-self: start; } h3 { font-size: 26px; }
  .pill { display: inline-flex; align-items: center; gap: 8px; width: fit-content; padding: 8px 14px; border-radius: 999px; font-size: 13px; font-weight: 900; background: var(--soft); color: var(--primary-text); }
  .owner .pill { background: #FDE7F1; color: #9D174D; } :global([data-theme="dark"]) .owner .pill, .b .owner .pill { background: #3A1E2B; color: #F7A8C8; }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 15px; font-weight: 700; }
  .mode .btn { margin-top: 6px; width: fit-content; }
  .shot { --bezel: 5px; --r: 24px; width: 150px; margin-bottom: -60px; justify-self: end; }
  .buyer { display: grid; grid-template-columns: 56px 1fr auto; gap: 20px; align-items: center; padding: 24px 28px; background: var(--surface-2); border-color: transparent; }
  .buyer h3 { font-size: 20px; } .buyer p { font-size: 15px; margin-top: 4px; }
  .qr { width: 56px; height: 56px; border-radius: 16px; background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; }
  @media (max-width: 900px) {
    .aud { padding: 56px 0 8px; } h2 { font-size: 30px; } h3 { font-size: 22px; }
    .mode { grid-template-columns: 1fr; padding: 24px 20px 0; gap: 16px; } .shot { justify-self: center; width: 140px; margin-bottom: -40px; }
    .buyer { grid-template-columns: 48px 1fr; padding: 20px; } .buyer .btn { grid-column: 1 / -1; width: 100%; } .qr { width: 48px; height: 48px; }
  }
</style>
