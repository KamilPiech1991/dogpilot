---
import StoreButtons from './StoreButtons.astro';
import Paws from './Paws.astro';
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang; variant?: 'a' | 'b' }
const { lang, variant = 'a' } = Astro.props;
const c = t(lang);
---
<section class="fc"><div class="wrap"><div class={`box ${variant} reveal`}><Paws layout="scatter" size={64} color="#FFFFFF" opacity={.14} />
  <div class="copy"><h2>{c.cta.h2}</h2><p>{c.cta.p}</p><div class="ctas"><a href="/rejestracja" class="btn main">{c.cta.button}</a><StoreButtons lang={lang} compact /></div></div>
  <div class="qr"><a href="/pobierz" class="code"><img src="/img/qr-pobierz.svg" alt={c.cta.qrAlt} width="150" height="150" loading="lazy"></a><span>{c.cta.qr}</span></div>
</div></div></section>
<style>
  .fc { padding: 0 0 96px; } .box { position: relative; overflow: hidden; border-radius: 32px; padding: 56px; display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 32px; align-items: center; }
  .box.a { background: linear-gradient(135deg, #32BF46 0%, #1F8A30 100%); color: #FFFFFF; } .box.b { background: var(--primary); color: var(--on-primary); border-radius: 36px; }
  .copy { display: flex; flex-direction: column; gap: 18px; } h2 { font-size: 40px; } .copy p { font-size: 18px; opacity: .95; } .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .main { background: #FFFFFF; color: #1F8A30; } .box.b .main { background: #0F1A15; color: #EAF4EE; } .box.a .store { background: rgba(0,0,0,.25); } .box.b .store { background: rgba(15,26,21,.12); color: #0F1A15; border: 1px solid rgba(15,26,21,.25); }
  .qr { justify-self: end; background: #FFFFFF; border-radius: 20px; padding: 16px; display: flex; flex-direction: column; align-items: center; gap: 10px; color: #1F1A17; font-size: 12px; font-weight: 800; text-align: center; max-width: 190px; } .box.b .qr { background: #0F1A15; color: #EAF4EE; }
  .code { display: block; width: 150px; height: 150px; border-radius: 12px; overflow: hidden; background: #FFFFFF; } .code img { width: 150px; height: 150px; }
  @media (max-width: 900px) { .box { grid-template-columns: 1fr; padding: 32px 24px; border-radius: 24px; } .qr { justify-self: start; } h2 { font-size: 30px; } .fc { padding-bottom: 56px; } }
</style>
