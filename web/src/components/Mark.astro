---
// Znak Dogpilot – ten sam co w aplikacji (kafelek z gradientem i łapką ze splash screenu).
interface Props { size?: number; class?: string }
const { size = 40, class: cls = '' } = Astro.props;
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  <defs><linearGradient id="dp-mark-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#32BF46"/><stop offset="1" stop-color="#1F5B43"/></linearGradient></defs>
  <rect width="96" height="96" rx="30" fill="url(#dp-mark-g)"/>
  <g transform="translate(21 21) scale(2.25)" fill="#FFFFFF"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><circle cx="4.5" cy="8.5" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></g>
</svg>
<style>.mark { display: block; flex-shrink: 0; }</style>
