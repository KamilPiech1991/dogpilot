---
import Icon from './Icon.astro';
import { SITE, t, type Lang } from '../i18n/content';
interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const c = t(lang);
---
<a href={SITE.playUrl} class="store" rel="noopener" data-track="play"><Icon name="playstore" size={22} />{compact ? <b>Google Play</b> : <span>{c.hero.getIt}<b>Google Play</b></span>}</a>
<a href={SITE.appStoreUrl} class="store" rel="noopener" data-track="appstore"><Icon name="apple" size={22} />{compact ? <b>App Store</b> : <span>{c.hero.getIt}<b>App Store</b></span>}</a>
