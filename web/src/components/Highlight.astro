---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang; variant?: 'a' | 'b' }
const { lang, variant = 'a' } = Astro.props;
const c = t(lang);
---
<section class={`hl ${variant}`}>
  {variant === 'a' && <svg class="w top" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 L1440 0 L1440 20 C 1200 90, 900 0, 720 40 S 240 90, 0 30 Z" fill="var(--surface)"></path></svg>}
  <div class={`wrap ${variant === 'b' ? 'box' : 'col'}`}>
    <div class="copy reveal">
      <span class="kicker light">{c.highlight.kicker}</span>
      <h2>{c.highlight.h2}</h2>
      <p>{c.highlight.p}</p>
      <ul>{c.highlight.bullets.map(b => <li class="check"><Icon name="check" size={20} stroke={2.6} />{b}</li>)}</ul>
      {variant === 'b' && <div class="ctas"><a href="/poradnik/odbior-szczeniaka-od-hodowcy" class="btn btn-p">{c.highlight.cta}</a><a href="#funkcje" class="btn btn-o ghost">{c.highlight.cta2}</a></div>}
    </div>
    <div class="phones reveal">
      {variant === 'a' && <div class="phone p1"><img src="/img/app/m-miot.webp" alt={c.highlight.alts[0]} width="390" height="844" loading="lazy"></div>}
      <div class="phone p2"><img src="/img/app/m-pawid.webp" alt={c.highlight.alts[1]} width="390" height="844" loading="lazy"></div>
      <div class="phone p3"><img src="/img/app/m-miot-wagi.webp" alt={c.highlight.alts[2]} width="390" height="844" loading="lazy"></div>
    </div>
  </div>
  {variant === 'a' && <svg class="w bottom" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 80 L1440 80 L1440 50 C 1200 -10, 900 80, 720 40 S 240 -10, 0 50 Z" fill="var(--bg)"></path></svg>}
</section>
<style>
  .hl { position: relative; overflow: hidden; color: #FFFFFF; }
  .hl.a { background: linear-gradient(135deg, #32BF46 0%, #1F8A30 100%); padding: 88px 0 96px; }
  .hl.b { padding: 72px 0; color: var(--text); }
  .w { position: absolute; left: 0; width: 100%; height: 80px; } .top { top: -1px; } .bottom { bottom: -1px; }
  .col { position: relative; display: flex; flex-direction: column; gap: 40px; }
  .box { position: relative; border-radius: 36px; background: linear-gradient(135deg, #1F8A30 0%, #0F1A15 70%); border: 1px solid var(--border); padding: 64px; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; color: #FFFFFF; }
  .box::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(600px 400px at 90% 10%, rgba(79,212,99,.35), transparent 70%); pointer-events: none; }
  .copy { position: relative; max-width: 720px; display: flex; flex-direction: column; gap: 16px; } .light { color: #C9F0D1; }
  h2 { font-size: 44px; } .copy p { font-size: 18px; opacity: .95; max-width: 640px; }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px 28px; font-weight: 700; } .check svg { color: #FFFFFF; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; } .ghost { background: rgba(255,255,255,.06); color: #FFFFFF; border-color: #27392F; }
  .phones { position: relative; display: flex; gap: 28px; justify-content: center; align-items: flex-end; flex-wrap: wrap; }
  .p1 { width: 250px; transform: rotate(-4deg); } .p2 { width: 280px; margin-bottom: 24px; } .p3 { width: 250px; transform: rotate(4deg); }
  .hl.b .p2 { width: 250px; margin: 0; } .hl.b .p3 { width: 230px; transform: rotate(-5deg) translateY(16px); order: -1; }
  @media (max-width: 900px) { h2 { font-size: 30px; } .box { grid-template-columns: 1fr; padding: 32px 24px; border-radius: 24px; } .p1, .p3 { display: none; } .p2 { width: 200px; max-width: 60vw; margin: 0; } .phones { gap: 0; } .hl.b .p3 { display: none; } .hl.a { padding: 56px 0 112px; } .hl.b { padding: 40px 0; } }
</style>
