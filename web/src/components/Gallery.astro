---
import { t, type Lang } from '../i18n/content';
interface Props { lang: Lang; variant?: 'a' | 'b' }
const { lang, variant = 'a' } = Astro.props;
const c = t(lang);
---
<section class="gal"><div class="wrap col">
  <div class="head"><div><span class="kicker">{c.gallery.kicker}</span><h2>{variant === 'b' ? c.gallery.h2b : c.gallery.h2}</h2></div><p class="muted">{variant === 'b' ? c.gallery.pB : c.gallery.p}</p></div>
  <div class="strip" tabindex="0" aria-label={c.gallery.kicker}>{c.gallery.items.map(([img, cap]) => <figure><div class="phone"><img src={`/img/app/${img}.webp`} alt={cap} width="390" height="844" loading="lazy"></div><figcaption>{cap}</figcaption></figure>)}</div>
</div></section>
<style>
  .gal { padding: 56px 0 80px; } .col { display: flex; flex-direction: column; gap: 28px; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; } h2 { font-size: 34px; margin-top: 8px; } .head p { max-width: 420px; }
  .strip { display: flex; gap: 20px; overflow-x: auto; padding: 8px 4px 20px; scroll-snap-type: x mandatory; max-width: 100%; min-width: 0; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; }
  figure { margin: 0; flex: 0 0 230px; scroll-snap-align: start; display: flex; flex-direction: column; gap: 10px; } .phone { padding: 7px; border-radius: 30px; } .phone img { border-radius: 24px; }
  figcaption { font-weight: 800; font-size: 14px; text-align: center; color: var(--muted); }
  @media (max-width: 900px) { .gal { padding: 48px 0 56px; } figure { flex-basis: 170px; } .strip { gap: 14px; margin: 0 -18px; padding: 8px 18px 16px; scroll-padding-left: 18px; max-width: calc(100% + 36px); } h2 { font-size: 28px; } }
</style>
