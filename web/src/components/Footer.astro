---
import Icon from './Icon.astro';
import { SITE, t, type Lang } from '../i18n/content';
import { getCollection } from 'astro:content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const posts = (await getCollection('poradnik')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 6);
---
<footer id="kontakt" class="ft">
  <div class="wrap cols">
    <div class="col about">
      <img src="/brand/wordmark-white.png" alt="Dogpilot" width="140" height="28" style="height: 28px; width: auto">
      <p>{c.footer.about}</p>
      <address>{SITE.company}<br>{SITE.address[0]}<br>{SITE.address[1]}<br><a href="/kontakt">{SITE.email}</a></address>
      <div class="social"><a href="#" aria-label="Facebook"><Icon name="facebook" size={18} /></a><a href="#" aria-label="Instagram"><Icon name="instagram" size={18} /></a><a href="#" aria-label="YouTube"><Icon name="youtube" size={18} /></a></div>
    </div>
    <div class="col"><b>{c.footer.product}</b>{c.footer.productLinks.map(([l, h]) => <a href={h}>{l}</a>)}</div>
    <div class="col"><b>{c.footer.guide}</b>{posts.map(p => <a href={`/poradnik/${p.id}`}>{p.data.title}</a>)}</div>
    <div class="col"><b>{c.footer.legal}</b>{c.footer.legalLinks.map(([l, h]) => <a href={h}>{l}</a>)}
      <form class="nl" action="#" method="post"><label for="nl">{c.footer.newsletter}</label><div><input id="nl" type="email" name="email" placeholder={c.footer.emailPh} required><button type="submit" class="btn btn-p btn-sm">{c.footer.subscribe}</button></div></form>
    </div>
  </div>
  <div class="wrap bottom"><span>© {new Date().getFullYear()} {SITE.company} · {SITE.name}. {c.footer.rights}</span><span class="langs"><a href="/" aria-current={lang === 'pl' ? 'page' : undefined}>Polski</a><a href="/en/" aria-current={lang === 'en' ? 'page' : undefined}>English</a></span></div>
</footer>
<style>
  .ft { background: var(--dark); color: var(--on-dark); padding: 64px 0 32px; }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
  .col { display: flex; flex-direction: column; gap: 10px; font-size: 15px; } .col b { color: #FFFFFF; margin-bottom: 2px; } .col a { color: var(--dark-muted); } .col a:hover { color: #FFFFFF; }
  .about p, .about address { color: var(--dark-muted); font-style: normal; line-height: 1.6; max-width: 320px; } .about address a { color: var(--primary-hover); }
  .social { display: flex; gap: 10px; } .social a { width: 40px; height: 40px; border-radius: 12px; background: rgba(255,255,255,.08); color: var(--on-dark); display: flex; align-items: center; justify-content: center; }
  .nl { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; } .nl label { color: #FFFFFF; font-weight: 800; } .nl div { display: flex; gap: 8px; }
  .nl input { flex: 1; min-width: 0; height: 44px; border-radius: 12px; border: 1px solid var(--dark-border); background: rgba(255,255,255,.06); color: #FFFFFF; padding: 0 12px; font: inherit; font-size: 14px; }
  .nl .btn { box-shadow: none; }
  .bottom { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--dark-border); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; color: var(--dark-muted); font-size: 13px; }
  .langs { display: flex; gap: 14px; } .langs a { color: var(--dark-muted); } .langs a[aria-current] { color: #FFFFFF; font-weight: 800; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; gap: 28px; } }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr; } }
</style>
