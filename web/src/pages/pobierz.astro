---
import Layout from '../layouts/Layout.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { SITE } from '../i18n/content';
---
<Layout lang="pl" path="/pobierz" title="Pobierz Dogpilot – Android, iPhone, przeglądarka" description="Jeden link do aplikacji Dogpilot: Google Play, App Store i aplikacja webowa.">
  <section class="section"><div class="wrap box">
    <span class="kicker">Pobierz aplikację</span>
    <h1>Dogpilot na Twoim telefonie</h1>
    <p class="lead">Na telefonie otworzymy od razu właściwy sklep. Na komputerze zeskanuj kod albo otwórz aplikację webową.</p>
    <div class="ctas"><StoreButtons lang="pl" /><a href="/logowanie" class="btn btn-o">Aplikacja webowa</a></div>
    <div class="qr"><img src="/img/qr-pobierz.svg" alt="Kod QR – dogpilot.pl/pobierz" width="200" height="200"><span class="muted">dogpilot.pl/pobierz</span></div>
  </div></section>
  <script define:vars={{ play: SITE.playUrl, ios: SITE.appStoreUrl }}>
    const ua = navigator.userAgent;
    if (/android/i.test(ua)) location.replace(play);
    else if (/iphone|ipad|ipod/i.test(ua)) location.replace(ios);
  </script>
</Layout>
<style>.box { display: flex; flex-direction: column; gap: 18px; align-items: center; text-align: center; max-width: 720px; } h1 { font-size: 44px; } .ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; } .qr { display: flex; flex-direction: column; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: 20px; margin-top: 12px; } .qr img { border-radius: 12px; } @media (max-width: 900px) { h1 { font-size: 32px; } }</style>
