---
import Layout from '../layouts/Layout.astro';
import Auth from '../components/Auth.astro';
import { t } from '../i18n/content';
const c = t('pl').login;
---
<Layout lang="pl" bare path="/logowanie" title={`${'login' === 'login' ? c.titleLogin : c.titleSignup} – Dogpilot`} description={'login' === 'login' ? c.leadLogin : c.leadSignup}><Auth lang="pl" mode="login" /></Layout>
